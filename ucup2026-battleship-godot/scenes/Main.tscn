[node name="HelpText" type="RichTextLabel" parent="Screens/Help/HelpVBox"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[b]Мета:[/b] першим знищити всі кораблі супротивника (20 палуб).\n\n[b]Флот:[/b] 1×4, 2×3, 3×2, 4×1. Кораблі не торкаються навіть по діагоналі.\n\n[b]Ходи:[/b] влучання дає додатковий хід, промах передає хід AI.\n\n[b]Радар 3×3:[/b] 1 раз за гру, підсвічує клітинки з кораблем, хід не завершує.\n\n[b]Авіаудар 3×3:[/b] 1 раз за гру, стріляє по всіх клітинках зони, після використання хід переходить до AI."

